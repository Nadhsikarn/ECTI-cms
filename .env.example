# Server
HOST=
PORT=
# Comma-separated origins allowed to call the API from a browser.
# Unset means Strapi's default of '*' — set this in production.
CORS_ORIGINS=

# Secrets
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Database
DATABASE_CLIENT=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=
DATABASE_FILENAME=
JWT_SECRET=

# Webhook
WEBHOOK_URL=
WEBHOOK_SECRET=

# Newsletter
# Publishing a news post prepares a *draft* campaign in Brevo — a person still
# has to open Brevo and press send. Set these in the Strapi Cloud dashboard
# (Settings → Variables) for production; this file is only the checklist.
#
# Without them nothing breaks and nothing is sent: the broadcast logs what it
# would have prepared and returns. Check the server log after a publish if you
# expected a campaign and none appeared.
NEWSLETTER_ENABLED=
# Must be exactly "true" to arm it. Leave unset while importing the legacy
# archive, or every post published lines up a campaign.

BREVO_API_KEY=
# The same key the front uses for signups and the contact form. Both
# deployments need their own copy — this one is not shared from Vercel.

BREVO_LIST_ID=
# Must be the SAME list the front adds confirmed subscribers to. Different
# numbers on the two sides fails silently: people join one list, campaigns go
# to the other.

NEWSLETTER_SENDER_EMAIL=
# An address verified in Brevo (https://app.brevo.com/senders/list).
# An unverified sender is rejected at send time, not at campaign creation.

NEWSLETTER_SENDER_NAME=
# Optional. Defaults to "ECTI Association".

PUBLIC_SITE_URL=
# Where the "read the full story" button points.
# Optional; defaults to https://ecti-thailand.org.
