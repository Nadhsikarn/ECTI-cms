{
  "kind": "collectionType",
  "collectionName": "tags",
  "info": {
    "singularName": "tag",
    "pluralName": "tags",
    "displayName": "News — Tag"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "key": {
      "type": "enumeration",
      "enum": [
        "announcements",
        "cfp",
        "awards",
        "publications",
        "article"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "news": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::news-post.news-post",
      "mappedBy": "tags",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
