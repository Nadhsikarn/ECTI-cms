{
  "kind": "collectionType",
  "collectionName": "tags",
  "info": {
    "singularName": "tag",
    "pluralName": "tags",
    "displayName": "News — Tag",
    "description": "Tags shown on the News page. Pick by format, not topic — everything ECTI posts is academic: announcements = general notices; cfp = open call for submissions with a deadline; academic = conference/lecture/seminar you attend; training = hands-on course or workshop you take part in; article = editorial piece."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "key": {
      "type": "enumeration",
      "enum": [
        "announcements",
        "cfp",
        "academic",
        "training",
        "article"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "news": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::news-post.news-post",
      "mappedBy": "tags",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
