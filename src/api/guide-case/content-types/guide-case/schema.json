      "enum": ["reimbursement", "loan"],
      "default": "reimbursement",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "subtitle": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "steps": {
      "type": "component",
      "repeatable": true,
      "component": "guide.guide-step",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
