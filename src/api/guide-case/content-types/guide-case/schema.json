{
  "kind": "collectionType",
  "collectionName": "guide_cases",
  "info": {
    "singularName": "guide-case",
    "pluralName": "guide-cases",
    "displayName": "Resources — Document Guide Case",
    "description": "One card on Resources → เอกสารของสมาคม: a reimbursement case (มีใบเสร็จ / ใบเสร็จไม่สมบูรณ์ / ไม่มีใบเสร็จ) or the loan case, with the list of documents to attach."
