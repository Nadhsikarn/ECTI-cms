{
  "kind": "collectionType",
  "collectionName": "association_documents",
  "info": {
    "singularName": "association-document",
    "pluralName": "association-documents",
    "displayName": "Resources — Association Document",
    "description": "Association documents (bylaws, reimbursement / loan forms) shown on Resources → เอกสารของสมาคม. Upload the PDF in the file field (or set a link)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "key": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "link": {
      "type": "string",
      "regex": "^https?://.+",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
