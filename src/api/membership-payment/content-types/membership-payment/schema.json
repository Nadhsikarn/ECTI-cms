{
  "kind": "singleType",
  "collectionName": "membership_payments",
  "info": {
    "singularName": "membership-payment",
    "pluralName": "membership-payments",
    "displayName": "Membership — Payment & Channels",
    "description": "Bank transfer details and application channels shown on the Membership page."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "bank_name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "bank_branch": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "account_name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "account_number": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "swift_code": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "payment_email": {
      "type": "email",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "online_portal_url": {
      "type": "string",
      "regex": "^https?://.+",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "note": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
